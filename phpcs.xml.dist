<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="WordPress Event Manager foundation">
    <description>PSR-12 for new PHP tests; historical runtime modules remain audited debt.</description>
    <file>tests</file>
    <exclude-pattern>*/tests/Runner/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <rule ref="PSR12"/>
    <!-- WordPress integration bootstrap intentionally registers a constant and loads fixtures. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>*/tests/integration-bootstrap.php</exclude-pattern>
    </rule>
</ruleset>
