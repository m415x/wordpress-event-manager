{
  "name": "m415x/wordpress-event-manager",
  "description": "WordPress Event Manager plugin development and test tools",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.3",
    "chillerlan/php-qrcode": "^6.0.1",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^4.0",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "scripts": {
    "test:unit": "phpunit --testsuite unit",
    "test": "phpunit --testsuite unit",
    "lint:php": "phpcs --standard=phpcs.xml.dist",
    "analyse:php": "phpstan analyse --configuration=phpstan.neon.dist --no-progress"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
