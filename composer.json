{
  "name": "m415x/wordpress-event-manager",
  "description": "WordPress Event Manager plugin development and test tools",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "scripts": {
    "test:unit": "phpunit --testsuite unit",
    "test": "phpunit --testsuite unit"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
